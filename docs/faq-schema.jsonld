{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Meeting Maestro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meeting Maestro is an AI-powered meeting automation platform that captures, transcribes, summarizes, and organizes your meetings automatically. It turns conversations into action items, agendas, task lists, CRM notes, and follow-up messages—ensuring nothing gets lost and your team stays aligned."
      }
    },
    {
      "@type": "Question",
      "name": "How does Meeting Maestro work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meeting Maestro joins your meetings (Zoom, Google Meet, Teams) or processes uploaded recordings. It generates accurate transcripts, real-time insights, structured summaries, next steps, tasks, deadlines, and CRM-ready notes. You can also export everything to tools like Notion, HubSpot, Salesforce, ClickUp, Asana, and Slack."
      }
    },
    {
      "@type": "Question",
      "name": "Who is Meeting Maestro for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meeting Maestro is built for founders, busy professionals, operators, sales teams, agencies, and project managers who want to eliminate manual note-taking and create automated follow-ups, agendas, and workflows across their entire organization."
      }
    },
    {
      "@type": "Question",
      "name": "Does Meeting Maestro support AI-generated follow-ups?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Meeting Maestro can create personalized follow-up emails, Slack messages, recap documents, and CRM entries using your tone, templates, and preferences. All follow-ups are automatically synced to your workspace or sent directly through your preferred platform."
      }
    },
    {
      "@type": "Question",
      "name": "Can Meeting Maestro integrate with CRMs and task managers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Meeting Maestro exports structured action items, summaries, and notes directly into HubSpot, Salesforce, Pipedrive, Notion, ClickUp, Asana, Trello, Linear, Slack, and more. Custom integrations can be automated using n8n, Make.com, or Zapier."
      }
    },
    {
      "@type": "Question",
      "name": "Is Meeting Maestro secure and compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meeting Maestro uses enterprise-grade encryption, secure storage, and strict access controls. Recordings and transcripts are never shared or used for training without permission. The platform follows modern privacy standards including GDPR and SOC-2 principles."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use Meeting Maestro without adding a bot to my live meetings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can upload meeting recordings manually or connect auto-upload from Zoom Cloud, Google Drive, Dropbox, or Loom. Many users prefer this for private or confidential meetings."
      }
    },
    {
      "@type": "Question",
      "name": "Is Meeting Maestro free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meeting Maestro offers a free tier with limited meeting credits. Paid plans unlock unlimited summaries, AI follow-ups, CRM sync, team workspaces, automation workflows, and advanced analytics."
      }
    },
    {
      "@type": "Question",
      "name": "How do I contribute ideas or feature requests?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can submit feature requests through the in-app feedback portal or via the Meeting Maestro community. The team actively prioritizes improvements based on user impact and roadmap alignment."
      }
    }
  ]
}
